Host pve
    HostName pve.lab.tomkatom.com
    User root

Host k3s
    HostName k3s.lab.tomkatom.com
    User debian

Host runner
    HostName runner.lab.tomkatom.com
    User debian

# Shared settings for the lab hosts
Host pve k3s runner
    IdentitiesOnly yes
    IdentityFile ~/.ssh/tom-admin.pub
    IdentityAgent ~/.bitwarden-ssh-agent.sock
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

# Reach the k8s API (6443) and Proxmox UI by name; only needed if you want ports forwarded rather than direct
Host k3s-fwd
    HostName k3s.lab.tomkatom.com
    User debian
    LocalForward 6443 127.0.0.1:6443
