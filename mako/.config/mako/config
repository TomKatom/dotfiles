font=JetBrainsMono Nerd Font 10
anchor=top-right
layer=overlay
width=340
height=120
margin=8
padding=10
border-size=2
border-radius=6
background-color=#24273a
text-color=#cad3f5
border-color=#8aadf4
progress-color=over #363a4f
icons=1
max-icon-size=40
icon-path=/usr/share/icons/Papirus-Dark
default-timeout=6000
max-visible=4
group-by=app-name
format=<b>%s</b>\n%b

[urgency=low]
border-color=#6e738d
default-timeout=3000

[urgency=critical]
border-color=#ed8796
default-timeout=0

[grouped]
format=<b>%s</b> (%g)\n%b

# Keep last: later criteria sections override earlier ones.
[mode=do-not-disturb]
invisible=1
